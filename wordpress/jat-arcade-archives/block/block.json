{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "jat-arcade/museum",
  "title": "JAT Arcade Archives",
  "category": "embed",
  "icon": "games",
  "description": "A playable 3D museum of video game history.",
  "keywords": ["arcade", "games", "museum", "retro"],
  "textdomain": "jat-arcade-archives",
  "attributes": {
    "height": { "type": "string", "default": "" },
    "exhibit": { "type": "string", "default": "" },
    "mode": { "type": "string", "default": "3d" }
  },
  "supports": { "html": false, "align": ["wide", "full"] },
  "editorScript": "jat-arcade-block"
}
